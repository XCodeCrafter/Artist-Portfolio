# Local development environment
# Copy this file to .env.local and fill the real values.
# Do not commit .env.local.

# App URL for localhost
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
GOOGLE_SITE_VERIFICATION=
SECURITY_CONTACT_EMAIL=xcodecrafter@gmail.com
TRUSTED_PROXY=false
ALLOW_FALLBACK_CONTENT=true

# Supabase Auth login
# Passwords are NOT stored here. Create the admin password on the Supabase Auth user.
# For hosted Supabase, use values from Project Settings -> API.
# For local Supabase CLI, use values from `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Development-only admin fallback. Production uses active admin_profiles rows.
ADMIN_EMAILS=you@example.com

# Generate at least 32 random characters. Required in production.
AUTH_SECURITY_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only Supabase admin key
# Recommended for full local admin testing, required in production.
# Never expose this value in client/browser code.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SERVICE_ROLE_SECRET
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=portfolio-media

# Keep Supabase active until the provider-neutral finalizer and a real
# ImageKit pilot upload are verified. External providers must fail closed.
MEDIA_UPLOAD_PROVIDER=supabase

# ImageKit no-card pilot. Use a same-account restricted pair with Media
# Management = Read and write and Account Management = None. Keep the private
# key server-only; never paste, commit, screenshot, log, or make it NEXT_PUBLIC_.
# Keep false until same-account preflight, 0037, finalization, and cleanup pass.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PILOT_UPLOAD_ENABLED=false
IMAGEKIT_WEBHOOK_SECRET=

# Dormant, client-owned Cloudflare R2 alternative. Leave blank for the
# ImageKit pilot. NEXT_PUBLIC_MEDIA_ORIGIN must be an exact HTTPS origin with
# no trailing slash or path; do not use r2.dev for production.
NEXT_PUBLIC_MEDIA_ORIGIN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The token above must be scoped only to this bucket.
R2_BUCKET_NAME=artist-portfolio-media-prod
MEDIA_PROCESSOR_URL=
MEDIA_PROCESSOR_SECRET=

# Contact form and rate limiting, only required when testing the contact workflow.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
BOOKING_TO_EMAIL=
BOOKING_FROM_EMAIL=
CRON_SECRET=
HEALTHCHECK_SECRET=
