# App
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Google Search Console HTML-tag verification token (token only).
GOOGLE_SITE_VERIFICATION=

# Public address listed in /.well-known/security.txt.
SECURITY_CONTACT_EMAIL=xcodecrafter@gmail.com

# Self-hosting only. Leave false on Vercel. Enable only behind a trusted
# reverse proxy that overwrites incoming forwarding headers and blocks direct access.
TRUSTED_PROXY=false

# Local/demo escape hatch only. Never enable on a public deployment: production
# fails closed instead of publishing the bundled placeholder artist identity.
ALLOW_FALLBACK_CONTENT=false

# Email sending via Resend
RESEND_API_KEY=your_resend_api_key_here
RESEND_WEBHOOK_SECRET=
BOOKING_TO_EMAIL=booking@example.com
BOOKING_FROM_EMAIL=booking@your-domain.com

# Random 16+ character secret. Vercel sends it as Bearer auth to the daily
# retention endpoint configured in vercel.json.
CRON_SECRET=

# Optional deep dependency health token. Without this Bearer token,
# /api/health exposes only a cheap cached liveness response.
HEALTHCHECK_SECRET=

# Supabase content database and Auth login
# Passwords are NOT stored in env files. Create the admin password on the Supabase Auth user.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Keep `supabase` active until the provider-neutral upload finalizer and a real
# ImageKit pilot upload are verified. Selecting an unready external provider
# must fail closed; creating provider credentials alone does not move media.
MEDIA_UPLOAD_PROVIDER=supabase

# ImageKit is the no-card pilot for Batch 7A. The public key and URL endpoint
# identify the account; the private key is server-only and must never use a
# NEXT_PUBLIC_ prefix or appear in logs/readiness responses.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# Keep false until the authenticated direct-upload pilot is implemented. This
# server-only flag may temporarily open the browser upload origin without
# switching the active provider away from Supabase.
IMAGEKIT_PILOT_UPLOAD_ENABLED=false

# Optional until signed ImageKit webhook reconciliation is implemented.
# Keep server-only and verify every webhook signature before changing data.
IMAGEKIT_WEBHOOK_SECRET=

# Dormant, client-owned Cloudflare R2 alternative for a future cutover. These
# values are not required for the ImageKit pilot and do not activate R2.
# NEXT_PUBLIC_MEDIA_ORIGIN must be an exact HTTPS origin with no trailing slash
# or path (for example https://media.example.com).
NEXT_PUBLIC_MEDIA_ORIGIN=

# Server-only default-jurisdiction Cloudflare R2 S3 credentials. If R2 is
# selected later, the client must own its billing account and the token must be
# Object Read & Write scoped only to R2_BUCKET_NAME.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=artist-portfolio-media-prod

# Server-only handoff to the durable image/video optimization worker selected
# for Batch 7A. The shared secret authenticates requests from this app.
MEDIA_PROCESSOR_URL=
MEDIA_PROCESSOR_SECRET=

# Admin allowlist. The email must match the Supabase Auth user email.
# Development fallback only; production authorization uses admin_profiles.
ADMIN_EMAILS=you@example.com

# At least 32 random characters. Used to pseudonymize all rate-limit/IP keys
# and bind one-time recovery challenges. Keep server-only and rotate deliberately.
AUTH_SECURITY_SECRET=

# Optional but recommended: enable Cloudflare Turnstile in Supabase Auth and
# expose only its public site key here. The Turnstile secret stays in Supabase.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Required for production admin access, writes, audit logs, and the database
# rate limiter from migration 0018. Never expose in browser code.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=portfolio-media
