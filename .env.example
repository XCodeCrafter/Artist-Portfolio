# App
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email sending via Resend
RESEND_API_KEY=your_resend_api_key_here
BOOKING_TO_EMAIL=booking@example.com
BOOKING_FROM_EMAIL=booking@your-domain.com

# Upstash Redis rate limiting
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Supabase content database and Auth login
# Passwords are NOT stored in env files. Create the admin password on the Supabase Auth user.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admin allowlist. The email must match the Supabase Auth user email.
# Development fallback only; production authorization uses admin_profiles.
ADMIN_EMAILS=you@example.com

# At least 32 random characters. Used to pseudonymize auth rate-limit keys and
# bind one-time recovery challenges. Keep server-only and rotate deliberately.
AUTH_SECURITY_SECRET=

# Optional but recommended: enable Cloudflare Turnstile in Supabase Auth and
# expose only its public site key here. The Turnstile secret stays in Supabase.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Required for production admin access, writes, and audit logs. Never expose in browser code.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=portfolio-media
